<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/btn_translate"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:background="@drawable/bubble_bg"
        android:gravity="center"
        android:text="번역"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView android:id="@+id/btn_auto" style="@style/PillButton" android:text="자동: 꺼짐" />
        <TextView android:id="@+id/btn_comic" style="@style/PillButton" android:text="만화: 꺼짐" />
        <TextView android:id="@+id/btn_compare" style="@style/PillButton" android:text="엔진 비교" />
        <TextView android:id="@+id/btn_clear" style="@style/PillButton" android:text="번역 지우기" />
        <TextView android:id="@+id/btn_stop" style="@style/PillButton" android:text="종료" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/pill_bg"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
